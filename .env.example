# =============================================================================
# Chaitanya 2k26 — Redis & High-Performance Caching Configuration
# =============================================================================

# Redis connection URL
# Examples:
# - Local Redis (default): redis://127.0.0.1:6379/0
# - Cloud Redis (Upstash / Redis Cloud): rediss://default:password@host:port
REDIS_URL=redis://127.0.0.1:6379/0

# Enable or disable Redis caching (true / false)
# When set to false or when Redis is unreachable, the system automatically falls
# back to the high-speed thread-safe in-memory cache without crashing.
REDIS_ENABLED=true

# Cache TTL for static assets (in seconds, default 86400 = 24 hours)
REDIS_DEFAULT_TTL=86400

# Cache TTL for dynamic API routes like /api/events (in seconds, default 300 = 5 min)
REDIS_API_TTL=300

# Maximum file size to hold directly in Redis RAM (in bytes, default 25MB = 26214400)
# Large files (> 25MB) bypass Redis RAM and stream via HTTP byte-range chunks.
REDIS_MAX_FILE_SIZE=26214400

# Local HTTP Server Port
PORT=3000
