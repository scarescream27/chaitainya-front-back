// Cloudflare Workers (static assets) deploy. Build command in the Cloudflare
// dashboard: `node scripts/build-pages.mjs`; deploy command: `npx wrangler deploy`.
// dist/_headers carries the same security headers as firebase.json.
{
  "name": "chaitanya-2k26",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // App routes like /events/<id> have no file: serve index.html, like the
    // firebase.json rewrite.
    "not_found_handling": "single-page-application"
  }
}
