# Large 3D source files and archives (>100MB GitHub limit)
*.blend
*.blend1
*.rar
unpack file/
*.hdr
# ...except the environment map the 3D scene loads at runtime
!hdri/*.hdr

# Dependencies & system files
node_modules/
.DS_Store
Thumbs.db
*.log
scratch/
*.backup.glb
.vscode/
.idea/

# Secrets & local config (use .env.example as the template)
.env
.env.*
!.env.example

# Python bytecode
__pycache__/
*.pyc

# Firebase CLI deploy cache
.firebase/
