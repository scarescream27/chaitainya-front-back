{
  "name": "chaitanya-2k26",
  "version": "1.1.0",
  "description": "Official 3D WebGL Web Platform for Chaitanya 2k26 — Annual Tech & Cultural Fest of Himachal Pradesh Technical University (HPTU Hamirpur)",
  "main": "server.py",
  "scripts": {
    "start": "python server.py",
    "dev": "python server.py",
    "redis": "python scripts/redis_dev_server.py",
    "cache:test": "python scripts/test_redis_cache.py",
    "serve": "npx serve . -l 3000",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:backend": "firebase deploy --only firestore",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "seed:firebase": "node scripts/apply-schema-firebase.mjs",
    "build": "echo 'Static web assets ready'"
  },
  "keywords": [
    "chaitanya-2k26",
    "hptu-hamirpur",
    "threejs",
    "webgl",
    "cannon-es",
    "gsap",
    "scroll-motion-ui",
    "events-arena",
    "sbi-upi-verification",
    "college-fest",
    "tech-cultural-fest"
  ],
  "author": "HPTU Hamirpur <chaitanyahptu@gmail.com>",
  "license": "MIT",
  "homepage": "https://chaitanyahptu.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/scarescream27/chaitainya-front-back.git"
  }
}
