rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Keep in sync with ADMIN_EMAILS in _nuxt/firebase-config.js
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in [
          "chaitanyahptu@gmail.com",
          "adityaverma200911@gmail.com",
          "manaskapoor033@gmail.com"
        ];
    }

    function data() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function isStudentId(value) {
      return value is string && value.matches('^CH26-[A-Z2-9]{8}$');
    }

    function isUtr(value) {
      return value is string && value.matches('^[0-9]{12}$');
    }

    // Razorpay payment id from checkout (test mode). No server checks its
    // signature, so an admin still confirms it against the Razorpay dashboard.
    function isRazorpayPaymentId(value) {
      return value is string && value.matches('^pay_[A-Za-z0-9]{14}$');
    }

    // UPI payments carry a 12-digit UTR; Razorpay payments a pay_ id.
    function isPaymentRef(method, ref) {
      return (method == 'razorpay' && isRazorpayPaymentId(ref)) ||
        (method != 'razorpay' && isUtr(ref));
    }

    // No HTML tags in user-entered text: blocks '<' followed by a letter, '/',
    // '!' or '?' (e.g. <img onerror=...>, <script>, </b>, <!-- ) so markup can
    // never be stored, while "<3" or "a < b" in a message still pass. The site
    // also escapes everything it renders; this keeps payloads out of the data.
    function noTags(value) {
      return !(value is string) || !value.matches('[\\s\\S]*<[A-Za-z/!?][\\s\\S]*');
    }

    // Item i of a list of maps (team members, payment items): field has no tags.
    function noTagsAt(l, i, f) {
      return l.size() <= i || noTags(l[i].get(f, ''));
    }

    // Every item's field in a list of at most 25 maps (rules can't loop).
    function listNoTags(l, f) {
      return l is list && l.size() <= 25 &&
        noTagsAt(l, 0, f) &&
        noTagsAt(l, 1, f) &&
        noTagsAt(l, 2, f) &&
        noTagsAt(l, 3, f) &&
        noTagsAt(l, 4, f) &&
        noTagsAt(l, 5, f) &&
        noTagsAt(l, 6, f) &&
        noTagsAt(l, 7, f) &&
        noTagsAt(l, 8, f) &&
        noTagsAt(l, 9, f) &&
        noTagsAt(l, 10, f) &&
        noTagsAt(l, 11, f) &&
        noTagsAt(l, 12, f) &&
        noTagsAt(l, 13, f) &&
        noTagsAt(l, 14, f) &&
        noTagsAt(l, 15, f) &&
        noTagsAt(l, 16, f) &&
        noTagsAt(l, 17, f) &&
        noTagsAt(l, 18, f) &&
        noTagsAt(l, 19, f) &&
        noTagsAt(l, 20, f) &&
        noTagsAt(l, 21, f) &&
        noTagsAt(l, 22, f) &&
        noTagsAt(l, 23, f) &&
        noTagsAt(l, 24, f);
    }

    // Profile photo: empty, or a plain https URL with no quotes, brackets or spaces.
    function isSafePhotoUrl(value) {
      return value == null || value == '' ||
        (value is string && value.size() <= 2048 && value.matches('^https://[^"\'<>\\s]+$'));
    }

    // Entry fee as seeded by the admin "Sync events" action. An event that is
    // not seeded is treated as paid, so free sign-ups need the events synced.
    function eventIsFree(eventId) {
      let path = /databases/$(database)/documents/events/$(eventId);
      return exists(path) && get(path).data.entryFeeNum == 0;
    }

    // Temporary pause (8 Oct 2026, site link leaked early): no new
    // registrations, teams, payments or team joins until 9 Oct 2026 00:00 IST
    // (= 8 Oct 18:30 UTC). Lifts by itself. Keep in sync with
    // REGISTRATIONS_PAUSED_UNTIL in _nuxt/events-data.js.
    function registrationsPaused() {
      return request.time < timestamp.date(2026, 10, 8) + duration.time(18, 30, 0, 0);
    }

    function isPassId(value) {
      // CH26-<event hash>-<7 digits>; legacy CH26-<event prefix>-<5 digits> still valid.
      return value is string && value.matches('^CH26-([A-Z0-9]{4}-[0-9]{7}|[A-Z0-9]{1,4}-[0-9]{5})$');
    }

    // =========================================================================
    // USERS — profile is private to its owner and admins
    // =========================================================================
    match /users/{userId} {
      allow get: if isUser(userId) || isAdmin();
      // Only organisers query profiles (e.g. Digital ID lookup by studentId).
      allow list: if isAdmin();

      allow create: if isUser(userId) &&
        data().uid == userId &&
        data().email == request.auth.token.email &&
        isShortString(data().displayName, 120) &&
        isShortString(data().get('college', ''), 120) &&
        isShortString(data().get('year', ''), 40) &&
        isShortString(data().get('phone', ''), 20) &&
        isStudentId(data().studentId) &&
        noTags(data().displayName) && noTags(data().get('college', '')) &&
        noTags(data().get('year', '')) && noTags(data().get('phone', '')) &&
        isSafePhotoUrl(data().get('photoURL', '')) &&
        !('role' in data());

      allow update: if isAdmin() || (
        isUser(userId) &&
        data().email == request.auth.token.email &&
        data().get('role', null) == resource.data.get('role', null) &&
        isShortString(data().displayName, 120) &&
        isShortString(data().get('college', ''), 120) &&
        isShortString(data().get('year', ''), 40) &&
        isShortString(data().get('phone', ''), 20) &&
        noTags(data().displayName) && noTags(data().get('name', '')) &&
        noTags(data().get('college', '')) && noTags(data().get('year', '')) &&
        noTags(data().get('phone', '')) && isSafePhotoUrl(data().get('photoURL', '')) &&
        // Chaitanya ID: set once (for older profiles), never changed afterwards.
        (resource.data.get('studentId', null) == data().get('studentId', null) ||
          (resource.data.get('studentId', null) == null && isStudentId(data().studentId))) &&
        changedKeys().hasOnly(['displayName', 'name', 'email', 'photoURL', 'college', 'year', 'phone',
                               'studentId', 'registeredEvents', 'registeredEventIds', 'updatedAt'])
      );

      // Owners may delete their own profile ("Delete profile" on /profile).
      allow delete: if isAdmin() || isUser(userId);
    }

    // =========================================================================
    // EVENTS — public catalog, admin-managed
    // =========================================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        data().type in ['workshop', 'competition'] &&
        data().status in ['draft', 'published', 'completed', 'cancelled'];
      allow delete: if isAdmin();
    }

    // =========================================================================
    // TEAM CODES — code -> team lookup; fetch by exact code only, never listed
    // =========================================================================
    match /team_codes/{code} {
      allow get: if isAuthenticated();
      allow list, update: if isAdmin();
      // The leader registers their team's code in the same batch as the team.
      allow create: if isAdmin() || (
        isAuthenticated() &&
        data().keys().hasOnly(['teamId', 'eventId']) &&
        data().teamId == 'team_' + data().eventId + '_' + request.auth.uid &&
        getAfter(/databases/$(database)/documents/teams/$(data().teamId)).data.teamCode == code
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.teamId == 'team_' + resource.data.eventId + '_' + request.auth.uid
      );
    }

    // =========================================================================
    // TEAMS — fetched by id (from team_codes); only admins list them
    // =========================================================================
    match /teams/{teamId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();

      // Leader creates the team: roster of names, only their own account linked.
      allow create: if isAuthenticated() && !registrationsPaused() &&
        teamId == 'team_' + data().eventId + '_' + request.auth.uid &&
        data().leaderUid == request.auth.uid &&
        data().leader_id == request.auth.uid &&
        data().memberUids == [request.auth.uid] &&
        data().linkedMembers.size() == 1 &&
        data().members.size() >= 1 &&
        data().members.size() <= data().maxTeamSize &&
        data().maxTeamSize <= 20 &&
        data().teamSize == data().members.size() &&
        isShortString(data().teamName, 60) &&
        noTags(data().teamName) && noTags(data().get('team_name', '')) &&
        noTags(data().get('leaderName', '')) && noTags(data().get('college', '')) &&
        listNoTags(data().members, 'name') && listNoTags(data().linkedMembers, 'name') &&
        data().teamCode is string &&
        data().paymentStatus in ['free', 'pending'] &&
        (data().paymentStatus == 'pending' || eventIsFree(data().eventId));

      // A teammate links their account: they may only append themself, and only
      // alongside their registration carrying this team's code (proves they know it).
      allow update: if isAdmin() || (
        isAuthenticated() && !registrationsPaused() &&
        !(request.auth.uid in resource.data.memberUids) &&
        getAfter(/databases/$(database)/documents/registrations/$('reg_' + resource.data.eventId + '_' + request.auth.uid)).data.team_code == resource.data.teamCode &&
        changedKeys().hasOnly(['memberUids', 'linkedMembers']) &&
        data().memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
        data().linkedMembers.size() == resource.data.linkedMembers.size() + 1 &&
        data().linkedMembers.hasAll(resource.data.linkedMembers) &&
        data().linkedMembers[data().linkedMembers.size() - 1].uid == request.auth.uid &&
        noTags(data().linkedMembers[data().linkedMembers.size() - 1].get('name', '')) &&
        data().memberUids.size() <= resource.data.maxTeamSize
      ) || (
        // A linked teammate (not the leader) may take only themself off the team.
        isAuthenticated() &&
        request.auth.uid in resource.data.memberUids &&
        request.auth.uid != resource.data.leaderUid &&
        changedKeys().hasOnly(['memberUids', 'linkedMembers']) &&
        data().memberUids == resource.data.memberUids.removeAll([request.auth.uid]) &&
        data().linkedMembers.size() == resource.data.linkedMembers.size() - 1 &&
        resource.data.linkedMembers.hasAll(data().linkedMembers)
      );

      // The leader may delete their team while nobody else has linked to it
      // and nothing has been paid (deregistering from a team event).
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.leaderUid == request.auth.uid &&
        resource.data.memberUids == [request.auth.uid] &&
        resource.data.paymentStatus in ['free', 'rejected']
      );
    }

    // Legacy collections (no longer written by the app)
    match /team_members/{memberDocId} {
      allow read, write: if isAdmin();
    }
    match /teams/{teamId}/members/{memberId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // REGISTRATIONS — one per user per event: reg_{eventId}_{uid}
    // =========================================================================
    match /registrations/{regId} {
      // resource == null: lets a user check whether their own reg_* doc exists yet.
      allow get: if isAuthenticated() && (
        isAdmin() ||
        (resource == null && regId.matches('^reg_.*_' + request.auth.uid + '$')) ||
        (resource != null && resource.data.user_id == request.auth.uid)
      );
      // "My registrations" query must filter on user_id == own uid.
      allow list: if isAuthenticated() && (isAdmin() || resource.data.user_id == request.auth.uid);

      allow create: if isAuthenticated() && !registrationsPaused() &&
        regId == 'reg_' + data().event_id + '_' + request.auth.uid &&
        data().user_id == request.auth.uid &&
        data().participation_type in ['individual', 'team'] &&
        data().registration_status == 'registered' &&
        isPassId(data().registration_qr_id) &&
        noTags(data().get('user_name', '')) && noTags(data().get('user_college', '')) &&
        noTags(data().get('user_year', '')) && noTags(data().get('user_phone', '')) &&
        listNoTags(data().get('team_members', []), 'name') &&
        listNoTags(data().get('team_members', []), 'email') &&
        (
          data().payment_status == 'pending_verification' ||
          (data().payment_status == 'free' && eventIsFree(data().event_id)) ||
          // Teammates are covered by their leader's team payment.
          (data().payment_status == 'team' &&
            data().participation_type == 'team' &&
            getAfter(/databases/$(database)/documents/teams/$(data().team_id)).data.eventId == data().event_id &&
            request.auth.uid in getAfter(/databases/$(database)/documents/teams/$(data().team_id)).data.memberUids &&
            data().team_code == getAfter(/databases/$(database)/documents/teams/$(data().team_id)).data.teamCode)
        );

      // Owners may only cancel; payment status is set by admins.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        changedKeys().hasOnly(['registration_status']) &&
        data().registration_status == 'cancelled'
      );

      // Owners may deregister (delete) a registration that carries no payment,
      // so they can register again later. Paid bookings go through organisers.
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        resource.data.payment_status in ['free', 'team', 'rejected']
      );
    }

    // =========================================================================
    // PAYMENTS — UPI UTR submissions, verified only by admins
    // =========================================================================
    match /payments/{paymentId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.payerUid == request.auth.uid)
      );
      allow list: if isAdmin();

      // One payment per checkout: pay_{uid}_{timestamp}, covering `items`.
      allow create: if isAuthenticated() && !registrationsPaused() &&
        paymentId.matches('^pay_' + request.auth.uid + '_[0-9]+$') &&
        data().items is list && data().items.size() >= 1 && data().items.size() <= 25 &&
        data().payerUid == request.auth.uid &&
        data().status == 'pending_verification' &&
        data().verifiedAt == null &&
        data().verifiedBy == null &&
        isPaymentRef(data().get('method', 'upi'), data().transactionRef) &&
        noTags(data().get('payerName', '')) && noTags(data().get('payerPhone', '')) &&
        listNoTags(data().items, 'teamName') &&
        data().amount is number && data().amount > 0;

      // Payer may correct the UTR only after a rejection; admins verify/reject.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.payerUid == request.auth.uid &&
        resource.data.status == 'rejected' &&
        data().status == 'pending_verification' &&
        isPaymentRef(resource.data.get('method', 'upi'), data().transactionRef) &&
        changedKeys().hasOnly(['transactionRef', 'status', 'resubmittedAt'])
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // ANALYTICS — admin only (dashboard computes live counts from registrations)
    // =========================================================================
    match /event_analytics/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /event_daily_analytics/{dailyId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // FAQS
    // =========================================================================
    match /faqs/{faqId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // QUERIES — contact form
    // =========================================================================
    match /queries/{queryId} {
      allow create: if data().keys().hasOnly(['id', 'user_id', 'subject', 'message', 'name', 'email',
                                              'phone', 'team_name', 'status', 'created_at', 'updated_at']) &&
        isShortString(data().get('name', ''), 120) &&
        isShortString(data().get('email', ''), 200) &&
        isShortString(data().get('phone', ''), 20) &&
        isShortString(data().get('team_name', ''), 120) &&
        isShortString(data().subject, 200) &&
        isShortString(data().message, 5000) &&
        noTags(data().get('name', '')) && noTags(data().get('email', '')) &&
        noTags(data().get('phone', '')) && noTags(data().get('team_name', '')) &&
        noTags(data().subject) && noTags(data().message) &&
        data().status == 'open' &&
        (data().user_id == null || (isAuthenticated() && data().user_id == request.auth.uid));

      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.user_id == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // SCHEMA METADATA
    // =========================================================================
    match /_schema_metadata/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
