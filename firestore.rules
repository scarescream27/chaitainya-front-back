rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Keep in sync with ADMIN_EMAILS in _nuxt/firebase-config.js
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in [
          "chaitanyahptu@gmail.com",
          "adityaverma200911@gmail.com",
          "admin@chaitanya2k26.org"
        ];
    }

    function data() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function isStudentId(value) {
      return value is string && value.matches('^CH26-[A-Z2-9]{8}$');
    }

    function isUtr(value) {
      return value is string && value.matches('^[0-9]{12}$');
    }

    // Entry fee as seeded by the admin "Apply Schema" action. If events are
    // not seeded yet the fee cannot be checked here; the admin dashboard
    // flags unpaid registrations for paid events either way.
    function eventIsFree(eventId) {
      let path = /databases/$(database)/documents/events/$(eventId);
      return !exists(path) || get(path).data.entryFeeNum == 0;
    }

    // =========================================================================
    // USERS — profile is private to its owner and admins
    // =========================================================================
    match /users/{userId} {
      allow get: if isUser(userId) || isAdmin();
      // Only organisers query profiles (e.g. Digital ID lookup by studentId).
      allow list: if isAdmin();

      allow create: if isUser(userId) &&
        data().uid == userId &&
        data().email == request.auth.token.email &&
        isShortString(data().displayName, 120) &&
        isShortString(data().get('college', ''), 120) &&
        isShortString(data().get('year', ''), 40) &&
        isShortString(data().get('phone', ''), 20) &&
        isStudentId(data().studentId) &&
        !('role' in data());

      allow update: if isAdmin() || (
        isUser(userId) &&
        data().email == request.auth.token.email &&
        data().get('role', null) == resource.data.get('role', null) &&
        isShortString(data().displayName, 120) &&
        isShortString(data().get('college', ''), 120) &&
        isShortString(data().get('year', ''), 40) &&
        isShortString(data().get('phone', ''), 20) &&
        // Chaitanya ID: set once (for older profiles), never changed afterwards.
        (resource.data.get('studentId', null) == data().get('studentId', null) ||
          (resource.data.get('studentId', null) == null && isStudentId(data().studentId))) &&
        changedKeys().hasOnly(['displayName', 'name', 'email', 'photoURL', 'college', 'year', 'phone',
                               'studentId', 'registeredEvents', 'registeredEventIds', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // EVENTS — public catalog, admin-managed
    // =========================================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        data().type in ['workshop', 'competition'] &&
        data().status in ['draft', 'published', 'completed', 'cancelled'];
      allow delete: if isAdmin();
    }

    // =========================================================================
    // TEAMS — readable by signed-in users (needed to join by code)
    // =========================================================================
    match /teams/{teamId} {
      allow get: if isAuthenticated();
      // Participants may only look a team up by code (limit 1), not list them all.
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit <= 1);

      // Leader creates the team: roster of names, only their own account linked.
      allow create: if isAuthenticated() &&
        teamId == 'team_' + data().eventId + '_' + request.auth.uid &&
        data().leaderUid == request.auth.uid &&
        data().leader_id == request.auth.uid &&
        data().memberUids == [request.auth.uid] &&
        data().linkedMembers.size() == 1 &&
        data().members.size() >= 1 &&
        data().members.size() <= data().maxTeamSize &&
        data().maxTeamSize <= 20 &&
        data().teamSize == data().members.size() &&
        isShortString(data().teamName, 60) &&
        data().teamCode is string &&
        data().paymentStatus in ['free', 'pending'] &&
        (data().paymentStatus == 'pending' || eventIsFree(data().eventId));

      // A teammate links their account: they may only append themself.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        !(request.auth.uid in resource.data.memberUids) &&
        changedKeys().hasOnly(['memberUids', 'linkedMembers']) &&
        data().memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
        data().linkedMembers.size() == resource.data.linkedMembers.size() + 1 &&
        data().linkedMembers[data().linkedMembers.size() - 1].uid == request.auth.uid &&
        data().memberUids.size() <= resource.data.maxTeamSize
      );

      allow delete: if isAdmin();
    }

    // Legacy collections (no longer written by the app)
    match /team_members/{memberDocId} {
      allow read, write: if isAdmin();
    }
    match /teams/{teamId}/members/{memberId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // REGISTRATIONS — one per user per event: reg_{eventId}_{uid}
    // =========================================================================
    match /registrations/{regId} {
      // resource == null: lets a user check whether their own reg_* doc exists yet.
      allow get: if isAuthenticated() && (
        isAdmin() ||
        (resource == null && regId.matches('^reg_.*_' + request.auth.uid + '$')) ||
        (resource != null && resource.data.user_id == request.auth.uid)
      );
      // "My registrations" query must filter on user_id == own uid.
      allow list: if isAuthenticated() && (isAdmin() || resource.data.user_id == request.auth.uid);

      allow create: if isAuthenticated() &&
        regId == 'reg_' + data().event_id + '_' + request.auth.uid &&
        data().user_id == request.auth.uid &&
        data().participation_type in ['individual', 'team'] &&
        data().registration_status == 'registered' &&
        data().registration_qr_id is string &&
        (
          data().payment_status == 'pending_verification' ||
          (data().payment_status == 'free' && eventIsFree(data().event_id)) ||
          // Teammates are covered by their leader's team payment.
          (data().payment_status == 'team' &&
            data().participation_type == 'team' &&
            request.auth.uid in getAfter(/databases/$(database)/documents/teams/$(data().team_id)).data.memberUids)
        );

      // Owners may only cancel; payment status is set by admins.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        changedKeys().hasOnly(['registration_status']) &&
        data().registration_status == 'cancelled'
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // PAYMENTS — UPI UTR submissions, verified only by admins
    // =========================================================================
    match /payments/{paymentId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.payerUid == request.auth.uid)
      );
      allow list: if isAdmin();

      // One payment per checkout: pay_{uid}_{timestamp}, covering `items`.
      allow create: if isAuthenticated() &&
        paymentId.matches('^pay_' + request.auth.uid + '_[0-9]+$') &&
        data().items is list && data().items.size() >= 1 && data().items.size() <= 25 &&
        data().payerUid == request.auth.uid &&
        data().status == 'pending_verification' &&
        data().verifiedAt == null &&
        data().verifiedBy == null &&
        isUtr(data().transactionRef) &&
        data().amount is number && data().amount > 0;

      // Payer may correct the UTR only after a rejection; admins verify/reject.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.payerUid == request.auth.uid &&
        resource.data.status == 'rejected' &&
        data().status == 'pending_verification' &&
        isUtr(data().transactionRef) &&
        changedKeys().hasOnly(['transactionRef', 'status', 'resubmittedAt'])
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // ANALYTICS — admin only (dashboard computes live counts from registrations)
    // =========================================================================
    match /event_analytics/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /event_daily_analytics/{dailyId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // FAQS
    // =========================================================================
    match /faqs/{faqId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // QUERIES — contact form
    // =========================================================================
    match /queries/{queryId} {
      allow create: if isShortString(data().subject, 200) &&
        isShortString(data().message, 5000) &&
        data().status == 'open' &&
        (data().user_id == null || (isAuthenticated() && data().user_id == request.auth.uid));

      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.user_id == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // SCHEMA METADATA
    // =========================================================================
    match /_schema_metadata/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
