{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.blend",
      "*.blend1",
      "*.rar",
      "unpack*/**",
      "__pycache__/**",
      "server.py",
      "chaitanya_schema.sql",
      "FIREBASE_SCHEMA_MAPPING.md",
      "FIREBASE_SETUP.md",
      "README.md",
      "package-lock.json",
      "redis_cache.py",
      "scripts/**",
      "scratch/**",
      "*.pdf",
      "*.sql",
      "*.md",
      "package.json",
      "firestore.rules",
      "firestore.indexes.json",
      "events_catalog.json",
      "chaitainya-front-back/**",
      ".agent/**",
      ".gemini/**",
      ".claude/**",
      ".git/**",
      ".firebase/**",
      "**/*.exe",
      "**/*.cmd",
      "**/*.sh",
      "netlify.toml",
      "vercel.json"
    ],
    "rewrites": [
      {
        "regex": "^/[^.]*$",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, OPTIONS"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(glb|gltf|hdr|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(otf|ttf|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|mp3)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
